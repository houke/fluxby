meta {
  name: Create a new profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/profiles
  body: json
  auth: none
}

headers {
  X-Profile-Id: {{profileId}}
  X-Language: en
}

body:json {
  { "name": "Language test", "type": "personal" }
}

docs {
  # Create a new profile
  
  Set `X-Language` to `en` or `nl` to choose the language of the new profile's default categories. Dutch is used if omitted.
  
  ## Endpoint
  `POST /api/profiles`
}
